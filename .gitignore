frontend/dist/
backend/.venv/
__pycache__/
*.pyc

# ================================================================
# 系统杂项
# ================================================================
Thumbs.db
.DS_Store
*.log

# 并行会话的代码修改备份（开发中间产物）
change-backups/

# 个人资料目录（任何私人文件放这里都不会上传）
personal_data/

